# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/messmess_dev?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-replace-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-replace-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
