# Where the Next.js server proxies /api/v1/* to (the Express API)
API_ORIGIN=http://localhost:4000
# Socket.IO connects directly to the API server; set this to the public API origin in production.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Optional: call the API directly instead of through the proxy (needs CORS + cookie tuning)
# NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
